# ════════════════════════════════════════════════════════════════════════
# BloomOulu — CSC cPouta demo environment.
#
# This is the TEMPLATE. Don't edit it by hand on the VM — run
#   scripts/deploy-cpouta.sh <PUBLIC_HOST>
# which copies it to `.env`, substitutes PUBLIC_HOST, and fills every
# REPLACE_ME_* secret with freshly generated values.
#
# Payments stay in MOCK mode (test cards only): PAYTRAIL_MOCK=true,
# MobilePay disabled. No real money moves. This keeps the deployment within
# CSC's academic acceptable-use.
# ════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ── Public hostname ─────────────────────────────────────────────────────
# A resolvable hostname (NOT a bare IP — admin/kiosk are subdomains).
# Easiest: <your-floating-ip-with-dashes>.sslip.io  e.g. 195-148-30-10.sslip.io
# sslip.io resolves *.<dashed-ip>.sslip.io → the IP for free.
PUBLIC_HOST=REPLACE_ME_PUBLIC_HOST

# ── App URLs (single-host model: api is same-origin via web's rewrites) ──
NEXT_PUBLIC_WEB_URL=https://REPLACE_ME_PUBLIC_HOST
NEXT_PUBLIC_API_URL=https://REPLACE_ME_PUBLIC_HOST
NEXT_PUBLIC_ADMIN_URL=https://admin.REPLACE_ME_PUBLIC_HOST
NEXT_PUBLIC_KIOSK_URL=https://kiosk.REPLACE_ME_PUBLIC_HOST

# ── TLS ──────────────────────────────────────────────────────────────────
# Default: self-signed (browser warning, but always works, no rate limits).
# For trusted certs on a real/resolvable domain, set CADDY_TLS= (empty) and
# fill CADDY_ACME_EMAIL — Caddy will fetch Let's Encrypt certs automatically.
CADDY_TLS=tls internal
CADDY_ACME_EMAIL=

# ── Caddy listens on the real web ports; everything else is loopback-only ─
# Binding the other service ports to 127.0.0.1 means only Caddy (80/443) is
# reachable on the floating IP, even if the security group is loose.
CADDY_HTTP_PORT=80
WEB_PORT=127.0.0.1:3000
API_PORT=127.0.0.1:4000
ADMIN_PORT=127.0.0.1:4100
KIOSK_PORT=127.0.0.1:3100
POSTGRES_PORT=127.0.0.1:5432
REDIS_PORT=127.0.0.1:6379
RERANKER_PORT=127.0.0.1:8081
GRAFANA_PORT=127.0.0.1:3300
PROMETHEUS_PORT=127.0.0.1:9090

# ── Database (self-hosted Postgres 16 + pgvector container) ──────────────
POSTGRES_USER=bloomoulu
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD
POSTGRES_DB=bloomoulu

# ── Auth ──────────────────────────────────────────────────────────────────
AUTH_SECRET=REPLACE_ME_AUTH_SECRET
# University of Oulu staff SSO — leave empty for the demo (magic-link / admin
# bootstrap login still work).
AUTH_OULU_OIDC_ISSUER=
AUTH_OULU_OIDC_CLIENT_ID=
AUTH_OULU_OIDC_CLIENT_SECRET=
# First /admin sign-in. Script sets the hash; the plaintext is printed once.
ADMIN_BOOTSTRAP_EMAIL=admin@bloomoulu.demo
ADMIN_BOOTSTRAP_PASSWORD_HASH=REPLACE_ME_ADMIN_HASH

# ── Email (optional for a demo) ──────────────────────────────────────────
# Leave empty and the site runs fine; only actions that SEND mail (receipts,
# magic links) error until set. Easiest real option: a Gmail App Password.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=<you>@gmail.com  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BloomOulu <no-reply@bloomoulu.demo>
EMAIL_REPLY_TO=

# ── Payments — MOCK MODE, do not change (test cards only) ────────────────
PAYTRAIL_MOCK=true
PAYTRAIL_MERCHANT_ID=375917
PAYTRAIL_SECRET=SAIPPUAKAUPPIAS
PAYTRAIL_WEBHOOK_SECRET=SAIPPUAKAUPPIAS
PAYTRAIL_API_URL=https://services.paytrail.com
PAYTRAIL_RETURN_URL=https://REPLACE_ME_PUBLIC_HOST/en/donate/complete
PAYTRAIL_CALLBACK_URL=https://REPLACE_ME_PUBLIC_HOST/webhooks/paytrail
PAYMENTS_BANK_TRANSFER_ENABLED=true
PAYMENTS_PAYTRAIL_ENABLED=true
PAYMENTS_MOBILEPAY_ENABLED=false

# ── Local LLM (the deploy script pulls these into the ollama container) ──
OLLAMA_LLM_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=bge-m3

# ── Garden identity (demo placeholders — University of Oulu Botanical Garden) ─
GARDEN_ORG_NAME=Oulun yliopiston kasvitieteellinen puutarha
GARDEN_ORG_NAME_EN=BloomOulu — University of Oulu Botanical Garden
GARDEN_ORG_VAT_ID=FI02452579
GARDEN_ADDRESS=Linnanmaa, 90014 Oulun yliopisto
GARDEN_IBAN=FI00 0000 0000 0000 00
GARDEN_BIC=OKOYFIHH

# ── Contact (demo placeholders) ──────────────────────────────────────────
NEXT_PUBLIC_CURATOR_EMAIL=curator@bloomoulu.demo
NEXT_PUBLIC_SUPPORT_EMAIL=donate@bloomoulu.demo
ASK_CURATOR_EMAIL=curator@bloomoulu.demo
WEBAPP_USER_AGENT_EMAIL=conservation@bloomoulu.demo

# ── Bank-transfer reconciliation HMAC (demo: generated) ──────────────────
BANK_TRANSFER_WEBHOOK_SECRET=REPLACE_ME_BANK_SECRET
