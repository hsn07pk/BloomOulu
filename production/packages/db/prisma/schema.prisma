// BloomOulu — production schema.
//
// Conventions:
//   * Primary keys: UUID v7 (sortable, no enumeration).
//   * created_at / updated_at on every mutable row.
//   * Money stored in *minor units* (cents) as Int. Never floats.
//   * Soft-delete only where audit is mandatory (payments, receipts).
//   * Enums are explicit; we never invent a string at the application layer.
//
// Run `prisma generate` after edits.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, pg_trgm, unaccent, vector, btree_gin]
}

// ────────────────────────────────────────────────────────────────────────────
// Auth + users
// ────────────────────────────────────────────────────────────────────────────

enum UserRole {
  donor
  curator
  finance
  admin
}

enum Locale {
  en
  fi
  sv
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  emailVerified DateTime?
  // bcrypt hash for password-based sign-in. Null for staff using
  // University SSO or for donors who only ever used the magic-link
  // path. Set by the sign-up verify-and-setup endpoint.
  passwordHash  String?
  name          String?
  image         String?
  role          UserRole @default(donor)
  locale        Locale   @default(fi)

  // Donor-specific
  homeRegion    String?  // ISO 3166-2 (e.g. "FI-10" North Ostrobothnia) — for I@H pairing
  postalAddress Json?    // {line1, line2, postalCode, city, country} — needed for printed perks
  preferences   Json     @default("{}") // a11y prefs, marketing opt-in

  // Staff-specific
  ouluUid       String?  @unique // OIDC subject id when signed via University SSO

  // Operator-toggled deactivation. Distinct from `deletedAt` (which is the
  // GDPR-erasure pseudonymisation marker) — an admin disables a staff
  // account here while finance/legal hold prevents row deletion.
  deactivatedAt DateTime?

  accounts      Account[]
  sessions      Session[]
  adoptions     Adoption[]
  giftsReceived Adoption[]    @relation("giftRecipient")
  payments      Payment[]
  receipts      Receipt[]
  taxCertificates TaxCertificate[]
  askMessages   AskMessage[]
  savedPlants   SavedPlant[]
  dataExports   DataExportRequest[]
  erasures      DataErasureRequest[]
  auditLogs     AuditLog[]    @relation("auditActor")
  enrichmentReviews EnrichmentSuggestion[] @relation("enrichmentReviewer")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([locale])
  @@index([role])
  @@index([deletedAt])
}

// Auth.js v5 standard tables (kept minimal; we use email magic links + OIDC)
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ────────────────────────────────────────────────────────────────────────────
// Plant catalogue
// ────────────────────────────────────────────────────────────────────────────

enum RedListStatus {
  LC // Least Concern
  NT // Near Threatened
  VU // Vulnerable
  EN // Endangered
  CR // Critically Endangered
  EX // Extinct
  DD // Data Deficient
  NA // Not Applicable (cultivated, exotic showcase, etc.)
}

enum BloomSeason {
  spring
  summer
  autumn
  winter
  all
}

model Taxon {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  latinName    String  @unique
  family       String
  synonyms     String[] @default([])
  author       String?
  rank         String   @default("species")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  plants       Plant[]
}

model Plant {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String        @unique // short stable URL slug, e.g. "kangasvuokko" / "puls-pat"
  taxonId         String        @db.Uuid
  taxon           Taxon         @relation(fields: [taxonId], references: [id])

  // Common names
  nameEn          String
  nameFi          String
  nameSv          String

  // Status + story
  redListStatus   RedListStatus
  redListYear     Int           @default(2019)
  origin          String
  habitat         String
  biome           String
  bloomSeason     BloomSeason
  bloomWindow     String?       // "April - May"
  story           Json          // { en: "...", fi: "...", sv: "..." }
  quickFacts      Json          // [{labelKey: "origin", value: "Häme esker"}, ...]

  // Visual
  primaryImageId  String?       @unique @db.Uuid
  primaryImage    PlantImage?   @relation("primaryImage", fields: [primaryImageId], references: [id])
  images          PlantImage[]  @relation("plantImages")

  // Location in the garden (PostGIS geography point in WGS84)
  // Use Prisma's raw type since prisma-client doesn't have a first-class
  // PostGIS type — we get back a hex-encoded WKB.
  microLat        Decimal?      @db.Decimal(10, 7)
  microLng        Decimal?      @db.Decimal(10, 7)
  gardenZone      String?       // "south esker bed", "romeo greenhouse pond", ...

  // Funding state (denormalised counters; source of truth is Adoption rows)
  adopterCount    Int           @default(0)
  fundedCents     Int           @default(0)
  targetCents     Int           @default(0)
  status          String        @default("active") // active | retired | hidden

  // Denormalised counter for plant-scan events. Authoritative source is
  // the PlantScan table; this counter is bumped per insert via the
  // PlantsService.recordScan path so the homepage and admin index can
  // sort by popularity without scanning the event table.
  scanCount       Int           @default(0)

  // Denormalised counters for plant-detail engagement. Authoritative
  // sources stay in SavedPlant (saves) and AskAnswer (RAG retrievals
  // whose chunks linked to this plant); these are bumped transactionally
  // on insert in me.controller / ask.service. Both default to 0 and are
  // backfilled by the 20260524170000_plant_engagement_counters migration.
  // See docs/handover-files/stats-roadmap.md (Pattern B).
  saveCount       Int           @default(0)
  askCount        Int           @default(0)

  // Relations
  accessions      Accession[]
  adoptions       Adoption[]
  narrations      AudioNarration[]
  citations       PlantCitation[]
  ragChunks       RagChunk[]
  savedBy         SavedPlant[]
  quizQuestions   QuizQuestion[]
  scans           PlantScan[]
  enrichmentSuggestions EnrichmentSuggestion[]
  enrichmentSchedule    EnrichmentSchedule?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Indexes tuned for millions-of-plants scale.
  // * status, redListStatus, bloomSeason: low-cardinality filter facets.
  //   Composite indexes match the homepage's "active + red-list + season"
  //   query so a single scan answers it.
  // * adopterCount DESC + nameEn ASC: matches the default sort in
  //   PlantsController.list — Postgres uses it instead of a sort+scan.
  // * Trigram + full-text indexes on the localised names live in the
  //   migration (Prisma can't model gin(... gin_trgm_ops) yet); the
  //   PlantsController.list query uses them for the `q` parameter.
  @@index([status, redListStatus, bloomSeason])
  @@index([status, adopterCount(sort: Desc), nameEn])
  @@index([status, createdAt(sort: Desc)])
  @@index([taxonId])
}

model PlantImage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plantId         String?  @db.Uuid
  plant           Plant?   @relation("plantImages", fields: [plantId], references: [id], onDelete: Cascade)
  primaryFor      Plant?   @relation("primaryImage")

  url             String
  altEn           String
  altFi           String
  altSv           String
  attribution     String    // "© Photographer Name / Wikimedia, CC BY 4.0"
  licenseSpdx     String    @default("CC-BY-4.0")
  season          BloomSeason? // which seasonal variant
  width           Int?
  height          Int?

  createdAt       DateTime  @default(now())
}

model Accession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accessionNumber String   @unique // "OULU-1998-0421"
  plantId         String   @db.Uuid
  plant           Plant    @relation(fields: [plantId], references: [id])

  collectedAt     DateTime?
  collectedBy     String?
  sourcePopulation String?
  propagationLineage String[] @default([])
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────────
// Citations (peer-reviewed and internal)
// ────────────────────────────────────────────────────────────────────────────

enum CitationSourceType {
  paper
  report
  book
  database
  curator_note
  phenology_log
}

model Citation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType      CitationSourceType
  displayTitle    String
  authors         String?
  year            Int?
  identifier      String?  // DOI, ISBN, internal report ID
  url             String?
  page            String?
  notes           String?

  plants          PlantCitation[]
  askAnswers      AskAnswerCitation[]
  ragChunks       RagChunk[]
  ragDocuments    RagDocument[]

  createdAt       DateTime @default(now())
}

model PlantCitation {
  plantId    String   @db.Uuid
  citationId String   @db.Uuid
  context    String? // why this citation matters for this plant
  plant      Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  citation   Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([plantId, citationId])
}

// ────────────────────────────────────────────────────────────────────────────
// Audio narration
// ────────────────────────────────────────────────────────────────────────────

model AudioNarration {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plantId     String   @db.Uuid
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  locale      Locale
  audioUrl    String   // S3 signed URL is generated on demand; this is the canonical key
  durationMs  Int
  transcript  String   @db.Text // full transcript for captions + a11y
  captionsVtt String?  @db.Text // WebVTT for timed captions
  voiceCredit String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([plantId, locale])
}

// ────────────────────────────────────────────────────────────────────────────
// Adoption + tiers
// ────────────────────────────────────────────────────────────────────────────

enum TierId {
  seedling
  rooted
  vulnerable
  endangered
  corporate
}

enum BillingInterval {
  one_time
  annual
  monthly
}

enum AdoptionIntent {
  for_self
  gift
  memorial
  class
  corporate
}

enum AdoptionStatus {
  pending       // checkout started, awaiting first payment confirmation
  active
  paused        // dunning failed payment
  cancelled
  expired
}

model Tier {
  id              TierId  @id
  name            String  // canonical English
  nameFi          String
  nameSv          String
  annualPriceCents Int
  monthlyPriceCents Int?
  blurbEn         String
  blurbFi         String
  blurbSv         String
  perks           Json    // [{labelKey: "i_at_h_postcard", localeFallbacks: {...}}]
  // Marketing flair shown above the tier name (e.g. "Most popular gift",
  // "Best value", "Donor-wall listing"). Per-locale variants for fi/sv —
  // null means no tag shown.
  tagEn           String?
  tagFi           String?
  tagSv           String?
  // Visual
  color           String
  bg              String
  sortOrder       Int     @default(0)

  adoptions       Adoption[]
}

model Adoption {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  donorId         String   @db.Uuid
  donor           User     @relation(fields: [donorId], references: [id])

  plantId         String   @db.Uuid
  plant           Plant    @relation(fields: [plantId], references: [id])

  tierId          TierId
  tier            Tier     @relation(fields: [tierId], references: [id])

  status          AdoptionStatus  @default(pending)
  intent          AdoptionIntent  @default(for_self)

  // I@H — Internationalisation@Home (the donor's home region; we surface a plant
  // from that region as the suggested adoption).
  homeRegion      String?

  // Personalisation
  nickname        String?
  dedication      String?   // up to 240 chars
  showOnDonorWall Boolean   @default(true)
  publicName      String?   // override of donor.name on donor wall

  // Gift / memorial fields
  giftRecipientId String?   @db.Uuid
  giftRecipient   User?     @relation("giftRecipient", fields: [giftRecipientId], references: [id])
  giftCodeId      String?   @unique @db.Uuid
  giftCode        GiftCode? @relation(fields: [giftCodeId], references: [id])
  giftDeliverOn   DateTime? @db.Date   // when to email the recipient
  giftAnonymous   Boolean   @default(false) // "Send anonymously? Yes/No"
  giftWrap        Boolean   @default(false) // +€4 linen-card mailed cert
  memorialOf      String?
  memorialFamilyEmail String?           // bloom-anniversary mailings
  // Free-form co-adopters (split-the-gift feature) — stored as
  // [{ name?, email? }, ...]. We deliberately don't model these as
  // first-class Users so they don't need to verify email to be named.
  coAdopters      Json?
  // Donor consents (also mirrored to User.preferences but cached on the
  // Adoption row so the receipt + admin export reflect the exact moment
  // the donor opted in).
  marketingOptIn  Boolean   @default(false)

  // Billing
  recurring       Boolean   @default(true)
  billingInterval BillingInterval @default(annual)
  amountCents     Int                       // captured at creation time (tier price snapshot)
  currency        String    @default("EUR")
  startedAt       DateTime?
  endsAt          DateTime?
  cancelledAt     DateTime?
  cancellationReason String?

  // Plaque (Endangered tier and up)
  plaque          Plaque?

  payments        Payment[]

  // Bundle-checkout grouping: when a donor adopts multiple plants at
  // once from the cart, every Adoption in the cart shares the same
  // bundleId. The webhook activates all siblings on a single payment.
  bundleId        String?  @db.Uuid

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Composite hot-path indexes for thousands-of-adopters scale.
  // * (donorId, status, createdAt DESC) — My Garden fetches "my adoptions,
  //   newest first" in one index lookup.
  // * (plantId, status) — kiosk + plant pages count active adopters.
  // * (status, recurring, endsAt) — the daily renewal cron scans this
  //   without touching the rest of the table.
  // * (status, showOnDonorWall, startedAt DESC) — adopter wall feed.
  @@index([donorId, status, createdAt(sort: Desc)])
  @@index([plantId, status])
  @@index([status, recurring, endsAt])
  @@index([status, showOnDonorWall, startedAt(sort: Desc)])
  @@index([tierId])
  @@index([bundleId])
}

model GiftCode {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique // short human-friendly e.g. "ROOTED-7Q3K-AB42"
  redeemedAt      DateTime?
  expiresAt       DateTime
  adoption        Adoption?

  createdAt       DateTime @default(now())
}

model Plaque {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adoptionId      String   @unique @db.Uuid
  adoption        Adoption @relation(fields: [adoptionId], references: [id], onDelete: Cascade)
  engravedText    String
  status          String   @default("requested") // requested | engraving | installed
  installedAt     DateTime?
  installedByUserId String? @db.Uuid
  photoUrl        String?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────────
// Payments
// ────────────────────────────────────────────────────────────────────────────

enum PaymentProvider {
  paytrail
  mobilepay
  bank_transfer
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  cancelled
  requires_action
}

model Payment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Idempotent client-side identifier set at order creation, sent to the
  // provider as their idempotency key. Survives retries and reconciliation.
  orderId         String   @unique

  adoptionId      String?  @db.Uuid
  adoption        Adoption? @relation(fields: [adoptionId], references: [id])

  donorId         String   @db.Uuid
  donor           User     @relation(fields: [donorId], references: [id])

  provider        PaymentProvider
  providerCustomerId String? // stripe customer id / mobilepay agreement id
  providerPaymentRef String?  // stripe payment_intent / mobilepay charge id
  providerSessionId String?   // stripe checkout session id / mobilepay redirect id

  amountCents     Int
  currency        String   @default("EUR")
  netCents        Int      // after fees + VAT split
  vatRateBp       Int      @default(0) // in basis points; 0 if non-profit exempt
  vatCents        Int      @default(0)
  feeCents        Int      @default(0)
  refundedCents   Int      @default(0)

  status          PaymentStatus @default(pending)
  failureCode     String?
  failureMessage  String?

  receivedAt      DateTime?
  refundedAt      DateTime?

  receipt         Receipt?
  events          ProcessedEvent[]
  disbursementEntries DisbursementEntry[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Hot paths at scale:
  // * (donorId, status, receivedAt DESC) — annual tax-cert sweep + My
  //   Garden donor history.
  // * (status, receivedAt) — daily reconciliation cron's 30-day window
  //   scan.
  // * (provider, providerPaymentRef) — webhook lookups (already there).
  @@index([donorId, status, receivedAt(sort: Desc)])
  @@index([adoptionId])
  @@index([provider, providerPaymentRef])
  @@index([status, receivedAt])
}

// Idempotency table — one row per inbound provider event we have processed.
model ProcessedEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        PaymentProvider
  providerEventId String
  paymentId       String?  @db.Uuid
  payment         Payment? @relation(fields: [paymentId], references: [id])
  payloadDigest   String
  processedAt     DateTime @default(now())

  @@unique([provider, providerEventId])
}

// ────────────────────────────────────────────────────────────────────────────
// Disbursements — University-of-Oulu central treasury → Garden payouts
// ────────────────────────────────────────────────────────────────────────────
//
// Every donation lands in the University of Oulu's main bank account
// (the Garden has no merchant account of its own). The Garden's finance
// staff bundle settled Payments into a Disbursement, submit the claim
// to University finance, and reconcile when the University wires the
// total to the Garden's internal accounting code.

enum DisbursementStatus {
  draft       // staff is editing the claim
  ready       // staff signed off; locked, ready to submit
  submitted   // sent to University finance
  paid        // University has wired the funds to the Garden
  reconciled  // received amount matches expected; closed
  cancelled   // abandoned (wrong period, duplicate, etc.)
}

model Disbursement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable e.g. "DISB-2026-Q2-001". Unique, gapless within a year.
  reference       String   @unique
  periodStart     DateTime @db.Date
  periodEnd       DateTime @db.Date
  status          DisbursementStatus @default(draft)

  /// Sum of included Payments' amountCents.
  expectedCents   Int      @default(0)
  /// Sum of provider fees over the same payments.
  feeCents        Int      @default(0)
  /// expectedCents − feeCents (what the University should pay out).
  netCents        Int      @default(0)
  /// Amount actually received from the University on `paidAt`.
  paidCents       Int      @default(0)
  currency        String   @default("EUR")

  notes           String?
  submittedAt     DateTime?
  paidAt          DateTime?
  reconciledAt    DateTime?
  cancelledAt     DateTime?

  pdfUrl          String?
  csvUrl          String?
  csvSha256       String?

  createdByUserId String?  @db.Uuid

  entries         DisbursementEntry[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, periodEnd(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model DisbursementEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disbursementId  String   @db.Uuid
  disbursement    Disbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  paymentId       String   @db.Uuid
  payment         Payment  @relation(fields: [paymentId], references: [id])
  amountCents     Int
  feeCents        Int      @default(0)
  netCents        Int
  included        Boolean  @default(true)
  excludedReason  String?

  createdAt       DateTime @default(now())

  @@unique([disbursementId, paymentId])
  @@index([paymentId])
}

// ────────────────────────────────────────────────────────────────────────────
// Receipts + tax
// ────────────────────────────────────────────────────────────────────────────

enum ReceiptKind {
  donation       // standard adoption receipt
  refund         // credit note
  tax_certificate // annual roll-up for TVL §57 / new individual scheme
}

model Receipt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          String   @unique // gapless year-prefixed counter, e.g. "BLO-2026-000123"
  kind            ReceiptKind @default(donation)
  donorId         String   @db.Uuid
  donor           User     @relation(fields: [donorId], references: [id])
  paymentId       String?  @unique @db.Uuid
  payment         Payment? @relation(fields: [paymentId], references: [id])
  amountCents     Int
  currency        String   @default("EUR")
  vatLineJson     Json     // [{lineKey, gross, net, vatRateBp, vatCents}, ...]
  pdfUrl          String?  // signed S3 URL
  issuedAt        DateTime @default(now())
  pdfSha256       String?  // tamper-evidence

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TaxCertificate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donorId         String   @db.Uuid
  donor           User     @relation(fields: [donorId], references: [id])
  taxYear         Int
  totalCents      Int
  scheme          String   // "TVL §57 corporate" | "TVL §98a individual" (when launched)
  pdfUrl          String?
  issuedAt        DateTime @default(now())

  @@unique([donorId, taxYear])
}

// ────────────────────────────────────────────────────────────────────────────
// AskTheGarden — RAG corpus + Q/A log
// ────────────────────────────────────────────────────────────────────────────

model RagDocument {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  sourceCitationId String? @db.Uuid
  sourceCitation  Citation? @relation(fields: [sourceCitationId], references: [id])
  sourceUrl       String?
  locale          Locale   @default(en)
  body            String   @db.Text
  bodyHash        String   // sha256 of body — change detection for re-ingest
  isPublished     Boolean  @default(false)

  chunks          RagChunk[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([title, locale])
}

// Vector embeddings stored as pgvector(1024) — matches the Ollama
// `bge-m3` multilingual embedding model (100+ languages including the
// FI/SV/EN trio BloomOulu targets). Earlier dev iterations used
// nomic-embed-text:v1.5 (768-dim, English-only). Switching models
// requires re-ingesting the corpus and migrating the column width.
model RagChunk {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId      String   @db.Uuid
  document        RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex      Int
  text            String   @db.Text
  tokenStart      Int
  tokenEnd        Int
  locale          Locale
  embedding       Unsupported("vector(1024)")?
  // Optional cross-links so a retrieval result can ground straight to a plant
  plantId         String?  @db.Uuid
  plant           Plant?   @relation(fields: [plantId], references: [id])
  citationId      String?  @db.Uuid
  citation        Citation? @relation(fields: [citationId], references: [id])

  createdAt       DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([locale])
}

enum AskReaction {
  helpful
  off_base
  escalated
}

model AskMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?  @db.Uuid
  user            User?    @relation(fields: [userId], references: [id])
  locale          Locale
  text            String   @db.Text
  intent          String   @default("on_topic") // on_topic | off_topic | harmful
  createdAt       DateTime @default(now())
  answer          AskAnswer?
}

model AskAnswer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId       String   @unique @db.Uuid
  message         AskMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  text            String   @db.Text
  modelUsed       String
  promptTokens    Int
  completionTokens Int
  latencyMs       Int
  reaction        AskReaction?
  escalatedAt     DateTime?
  citations       AskAnswerCitation[]
  retrievedChunkIds String[] @default([])

  createdAt       DateTime @default(now())
}

model AskAnswerCitation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answerId        String   @db.Uuid
  answer          AskAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  citationId      String   @db.Uuid
  citation        Citation  @relation(fields: [citationId], references: [id])
  marker          String   // e.g. "[c1]"
  rank            Int
}

// ────────────────────────────────────────────────────────────────────────────
// Kiosk fleet
// ────────────────────────────────────────────────────────────────────────────

model KioskDevice {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label           String
  location        String   // romeo_lobby | julia_lobby | ticket_hall | events
  pairingCode     String?  @unique // human-friendly, single-use; cleared after pairing
  pairingExpiresAt DateTime?
  pairingTokenHash String? // bcrypt hash of the long-lived device JWT signing seed
  status          String   @default("unpaired") // unpaired | paired | offline
  lastSeen        DateTime?
  buildSha        String?
  notes           String?
  events          KioskEvent[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KioskEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId        String   @db.Uuid
  device          KioskDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind            String   // heartbeat | crash | reboot | qr_scan | error
  payload         Json     @default("{}")
  occurredAt      DateTime @default(now())

  @@index([deviceId, occurredAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Audit + GDPR
// ────────────────────────────────────────────────────────────────────────────

/// QR / physical-label scan event. Recorded every time a visitor lands on a
/// plant detail page with ?qr=1 (a code printed on a garden label). Used to
/// build "what's popular today" and the scan → adoption funnel in /admin.
/// Storage stays anonymous: only a SHA-256 hash of IP + UA so a returning
/// visitor can be counted as one "session" without us holding raw PII.
model PlantScan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plantId       String   @db.Uuid
  plant         Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  scannedAt     DateTime @default(now())
  /// UI locale at the time of the scan — useful for "Finnish vs English
  /// signage" comparisons.
  locale        String   @default("fi")
  /// Optional kiosk / terminal label printed on the QR sticker, e.g. the
  /// greenhouse zone code. Lets ops correlate which physical labels get
  /// the most attention.
  kioskId       String?
  /// SHA-256 of `${ip}|${userAgent}` (no salt by design — the hash is
  /// uniquely a "session"-ish bucket within a day, not a tracking key).
  /// Empty string when neither header was supplied.
  visitorHash   String   @default("")
  userAgent     String?

  @@index([plantId, scannedAt(sort: Desc)])
  @@index([scannedAt(sort: Desc)])
  @@index([kioskId, scannedAt(sort: Desc)])
}

/// EnrichmentSuggestion — proposed open-data value waiting for human review
/// before it touches a Plant. The 24/7 worker writes these instead of
/// updating Plant directly when the field is gated behind human review
/// (admin's `enrichment.autoApply.*` settings). Approved suggestions get
/// applied + archived; rejected ones stay for audit so nothing is lost.
///
/// One row per (plant, field, source, runId). A new enrichment run for the
/// same field supersedes the previous pending row by marking it `superseded`.
model EnrichmentSuggestion {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plantId         String                  @db.Uuid
  plant           Plant                   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  /// story / origin / status / image — matches EnrichField in enrichment/types.ts.
  field           String
  source          String
  sourceUrl       String?
  /// Confidence score 0..1 — used by the auto-apply gate.
  confidence      Float                   @default(0.8)
  /// The proposed value, normalised to its target shape:
  ///   • story  → { en, fi, sv, source: { provider, license, url, fetchedAt } }
  ///   • origin → string
  ///   • status → enum string (LC / NT / VU / EN / CR / EX / DD / NA)
  ///   • image  → { url, licenseSpdx, attribution, width?, height?, source }
  proposed        Json
  /// Snapshot of the current Plant value at the time the suggestion was created,
  /// so the reviewer sees a diff. JSON so we can store whichever shape the field uses.
  currentSnapshot Json?
  /// pending / approved / rejected / applied / superseded / auto_applied
  status          EnrichmentSuggestionStatus @default(pending)
  /// When auto_applied or approved, the moment the value landed on the Plant row.
  appliedAt       DateTime?
  reviewedAt      DateTime?
  reviewedById    String?                 @db.Uuid
  reviewedBy      User?                   @relation("enrichmentReviewer", fields: [reviewedById], references: [id])
  /// Free-form curator note attached on reject (e.g. "wrong species — synonym mismatch").
  reviewNote      String?
  /// BullMQ job that produced this — useful for grouping a single run's suggestions.
  /// Stored as text since BullMQ job ids are arbitrary strings, not UUIDs.
  jobRunId        String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([plantId, field, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([jobRunId])
}

enum EnrichmentSuggestionStatus {
  pending
  approved
  rejected
  applied
  superseded
  auto_applied
}

/// Per-plant enrichment scheduler — single row per plant tracking when it
/// was last enriched and when it's eligible to be enriched again. The
/// continuous worker reads `nextDueAt <= now()` to pick the next batch
/// instead of scanning the whole Plant table.
model EnrichmentSchedule {
  plantId       String   @id @db.Uuid
  plant         Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  lastRunAt     DateTime?
  lastResult    String?  // 'ok' | 'no-data' | 'error' | 'partial'
  lastError     String?
  /// Defaults to "lastRunAt + 30 days" but slows down for plants where
  /// every run returns no-data (no Wikipedia / GBIF entry exists).
  nextDueAt     DateTime @default(now())
  consecutiveNoData Int  @default(0)
  consecutiveErrors Int  @default(0)
  updatedAt     DateTime @updatedAt

  @@index([nextDueAt])
}

model AuditLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId     String?  @db.Uuid
  actor           User?    @relation("auditActor", fields: [actorUserId], references: [id])
  action          String   // e.g. "adoption.create", "payment.refund"
  resource        String   // e.g. "Adoption/8f3e..."
  before          Json?
  after           Json?
  ip              String?
  userAgent       String?
  occurredAt      DateTime @default(now())

  @@index([actorUserId, occurredAt])
  @@index([resource])
}

enum GdprRequestStatus {
  pending
  verified
  executing
  completed
  rejected
}

model DataExportRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  status          GdprRequestStatus @default(pending)
  exportUrl       String?  // signed link expiring in 24h
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

model DataErasureRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  status          GdprRequestStatus @default(pending)
  // Whether to pseudonymise (legal hold on financial records) vs full delete.
  approach        String   @default("pseudonymise")
  reason          String?
  decidedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

// ────────────────────────────────────────────────────────────────────────────
// Admin-editable runtime config (settings, translations, content, flags, emails)
// ────────────────────────────────────────────────────────────────────────────

/// Key/value typed settings — every business decision admins can flip.
/// Examples of `key`:
///   "payments.bank_transfer" | "payments.paytrail" | "payments.mobilepay"
///   "bankTransfer.iban" | "bankTransfer.bic" | "bankTransfer.beneficiaryName"
///   "vat.donationRateBp" | "vat.perkRateBp"
///   "features.rag" | "features.kiosk" | "features.corporateTier"
///   "receipts.prefix" | "receipts.yearReset"
///   "gdpr.auditRetentionDays" | "gdpr.pseudonymiseAfterDays"
///   "defaultAmountCents" | "adoptionFlow"
model SystemSetting {
  key             String   @id
  value           Json
  description     String?  // human-readable hint shown in admin UI
  category        String?  // grouping for admin nav: "payments" | "vat" | ...
  type            String?  // "boolean" | "number" | "string" | "json" | "iban"
  updatedByUserId String?  @db.Uuid
  updatedAt       DateTime @updatedAt @default(now())
}

/// Every public-facing UI string in FI / SV / EN.
/// The web app reads via the i18n package at build time; runtime overrides
/// come from this table. Admins edit in a Moodle-style table editor.
model Translation {
  i18nKey   String   @id    // e.g. "Adopt.tier_seedling" or "Receipts.thanks"
  en        String
  fi        String
  sv        String
  context   String?         // shown to translators as a hint
  status    String   @default("active") // active | needs_review | deprecated
  updatedAt DateTime @updatedAt @default(now())

  @@index([status])
}

/// CMS-style content blocks composing the homepage, "where your money goes" modal, etc.
model ContentBlock {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique         // "home.hero" | "policy.fundsFlow" | ...
  kind        String                    // "hero" | "callout" | "modal" | "policy" | "raw_md"
  bodyEn      String   @db.Text
  bodyFi      String   @db.Text
  bodySv      String   @db.Text
  imageUrl    String?
  ctaText     Json?    // { en: "Adopt", fi: "Adoptoi", sv: "Adoptera" }
  ctaHref     String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt @default(now())
}

/// Email templates — MJML body + per-locale subject/preheader.
model EmailTemplate {
  slug        String   @id          // "magic-link" | "receipt" | "gift-code" | ...
  subjectEn   String
  subjectFi   String
  subjectSv   String
  preheaderEn String?
  preheaderFi String?
  preheaderSv String?
  mjmlEn      String   @db.Text
  mjmlFi      String   @db.Text
  mjmlSv      String   @db.Text
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt @default(now())
}

/// Boolean feature flags — quick toggles without diving into SystemSetting.
model FeatureFlag {
  key         String   @id            // "rag" | "kiosk" | "corporateTier" | ...
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt @default(now())
}

/// VAT rules — what rate applies to which line type. Admin-editable.
model VatRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineKind    String   @unique  // "donation" | "perk" | "merch" | "event"
  rateBp      Int                // 0 | 1400 | 2400 (Finnish rates Jan 2026)
  description String?
  updatedAt   DateTime @updatedAt @default(now())
}

// ────────────────────────────────────────────────────────────────────────────
// Internal jobs queue mirror (BullMQ writes here for observability)
// ────────────────────────────────────────────────────────────────────────────

model JobRun {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queueName       String
  jobName         String
  payload         Json
  status          String   // queued | running | completed | failed
  attempts        Int      @default(0)
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([queueName, status])
}

// Per-user bookmark list. Click the ☆ on a plant page to add it; the row
// is the source of truth. Anonymous visitors get a localStorage-only
// shadow that's synced into this table on first sign-in. The compound
// unique constraint makes upserts idempotent.
model SavedPlant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  plantId   String   @db.Uuid
  note      String?  // optional donor-side note ("birthday gift for Mom")
  savedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant     Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([userId, plantId])
  @@index([userId, savedAt(sort: Desc)])
}

// School-mode quiz. Three to five questions per plant per locale, each a
// 4-option multiple choice. The same shape backs the printable worksheet
// (just rendered with checkboxes instead of buttons). Curators edit via
// AdminJS; seed populates Q&A for the shipped plants.
model QuizQuestion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plantId       String   @db.Uuid
  plant         Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  locale        Locale
  prompt        String   @db.Text
  options       String[] // exactly 4 strings; index of the correct one in `correctIndex`
  correctIndex  Int      // 0..3
  explanation   String?  @db.Text
  difficulty    String   @default("middle") // primary | middle | upper — for the reading-level toggle
  orderIndex    Int      @default(0)        // sort order within the same (plantId, locale, difficulty)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([plantId, locale, difficulty, orderIndex])
}

// Observability event log. Every meaningful event the system produces
// — HTTP request, job run, DB write side-effect, external API call,
// enrichment fetch, RAG ingest, payment webhook, fatal/error/warn from
// pino logs — is persisted here so a technical operator can search,
// trace, and replay the full system history from one screen.
//
// Severity is mirrored on pino's standard scale (trace/debug/info/warn/
// error/fatal). traceId groups events that belong to the same logical
// operation (one HTTP request fans out into N DB writes + an external
// call → all share the request's traceId).
//
// details is a free-form JSON payload — for HTTP events it includes
// {method,url,status,reqHeaders,resHeaders,bodyPreview}; for job
// events {queue,jobId,jobName,result,errorStack}; for external calls
// {host,latencyMs,upstreamStatus}.
//
// Retention is handled by a periodic delete-where-ts-older-than cron
// (configurable in SystemSetting `observability.retentionDays`).
model ObservabilityEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ts          DateTime @default(now())
  severity    String   // trace | debug | info | warn | error | fatal
  source      String   // http | job | rag | enrich | payment | admin | system | external
  message     String
  traceId     String?
  userId      String?
  durationMs  Int?
  details     Json     @default("{}")

  @@index([ts(sort: Desc)])
  @@index([severity, ts(sort: Desc)])
  @@index([source, ts(sort: Desc)])
  @@index([traceId])
}

// Persistent bulk-add plant job. The curator submits a list of Latin
// names (via paste or Excel upload) and the admin server processes them
// in the background — fetching enrichment in parallel, then batch-
// creating Plant rows. The full per-row state is stored as JSON so the
// curator can leave the page / close the browser / come back later and
// pick up exactly where they left off. Status transitions:
//   running   → enrichment / creation actively in flight
//   awaiting_review → enrichment done, curator must approve before create
//   completed → done (some rows may have failed; details in `items`)
//   cancelled → curator stopped it
model BulkAddJob {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdByUser  String?  // admin email (session id)
  status         String   @default("running")
  phase          String   @default("enrich")  // enrich | create | done
  items          Json     // [{ id, latinName, nameEn?, nameFi?, nameSv?, family?, status, preview?, keep, error?, createdId?, createdSlug? }, …]
  totals         Json     @default("{}")       // denormalised counters {queued,fetching,ready,failed,creating,created}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

// Anonymised quiz attempts so we can see "which questions confuse visitors
// the most" without retaining PII. Anonymous attempts use a session UUID;
// signed-in attempts also store userId so the donor can see history in /garden.
model QuizAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @db.Uuid
  plantId      String   @db.Uuid
  locale       Locale
  difficulty   String
  questionIds  String[] // ordered list of QuizQuestion.id presented
  answers      Int[]    // ordered list of selected option indices
  score        Int      // 0..questionIds.length
  durationMs   Int      // wall-clock time from quiz open to submit

  createdAt    DateTime @default(now())

  @@index([plantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}
