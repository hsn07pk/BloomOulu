# Real Gmail SMTP override.
#
# Copy this file to `.env.gmail` (gitignored), fill in the values, then
# bring the stack up with the override layered on top:
#
#   docker compose -f docker-compose.yml \
#                  -f docker-compose.localhost.yml \
#                  -f docker-compose.gmail.yml \
#                  --env-file .env.gmail up -d --force-recreate api api-worker
#
# How to get a Gmail App Password
#   1. Enable 2-step verification at https://myaccount.google.com/security
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Create a 16-character app password labelled "BloomOulu localhost"
#   4. Paste it as SMTP_PASS below
#
# When this override is active, every magic-link, curator-escalation,
# and receipt email leaves your machine via smtp.gmail.com and arrives
# in your real Gmail inbox. MailHog is bypassed entirely.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # gmail uses STARTTLS, not implicit TLS
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx   # the 16-char App Password from Google
SMTP_FROM=BloomOulu <your-gmail@gmail.com>
EMAIL_FROM=BloomOulu <your-gmail@gmail.com>
