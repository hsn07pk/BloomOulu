# ────────────────────────────────────────────────────────────────────────────
# BloomOulu — environment template.
# Copy to .env for development. NEVER commit a populated .env file.
# In production these are managed via Doppler (or SOPS+age for self-hosted).
# ────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_KIOSK_URL=http://localhost:3100
NEXT_PUBLIC_ADMIN_URL=http://localhost:4100

# ── Database (Postgres 16 + pgvector — self-hosted) ─────────────────────────
DATABASE_URL=postgresql://bloomoulu:bloomoulu@localhost:5432/bloomoulu?schema=public
DIRECT_URL=postgresql://bloomoulu:bloomoulu@localhost:5432/bloomoulu?schema=public

# ── Redis (BullMQ + cache, self-hosted) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (Auth.js v5, magic link via SMTP) ──────────────────────────────────
AUTH_SECRET=replace-with-openssl-rand-base64-32-chars-please-no-really
AUTH_URL=http://localhost:3000

# Staff SSO — University of Oulu IdP (production)
AUTH_OULU_OIDC_ISSUER=https://login.oulu.fi
AUTH_OULU_OIDC_CLIENT_ID=
AUTH_OULU_OIDC_CLIENT_SECRET=

# Bootstrap admin password (bcrypt hash). Set ONCE for first /admin sign-in.
# Generate: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# ── Email (Postal in prod; MailHog in dev) ──────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="BloomOulu <no-reply@bloomoulu.fi>"
EMAIL_REPLY_TO="garden@bloomoulu.fi"

# ── Paytrail (Finnish e-commerce: cards + FI banks + Apple/Google Pay) ──────
# Test merchant — public test creds from docs.paytrail.com. Replace with your
# real merchant before launch.
PAYTRAIL_MERCHANT_ID=375917
PAYTRAIL_SECRET=SAIPPUAKAUPPIAS
PAYTRAIL_WEBHOOK_SECRET=SAIPPUAKAUPPIAS
PAYTRAIL_API_URL=https://services.paytrail.com
PAYTRAIL_RETURN_URL=http://localhost:3000/en/donate/complete
PAYTRAIL_CALLBACK_URL=http://localhost:4000/webhooks/paytrail
# Mock the hosted-checkout step in dev/test (real signing still runs).
# MUST be `false` in production — otherwise the /v1/payments/paytrail-mock
# route stays exposed and a synthesized return-URL signature can activate
# adoptions without an actual Paytrail charge.
PAYTRAIL_MOCK=true

# ── Vipps MobilePay (recurring agreements) ──────────────────────────────────
# Test env URL: https://apitest.vipps.no  ·  Prod env URL: https://api.vipps.no
MOBILEPAY_API_URL=https://apitest.vipps.no
MOBILEPAY_CLIENT_ID=
MOBILEPAY_CLIENT_SECRET=
MOBILEPAY_SUBSCRIPTION_KEY=
MOBILEPAY_MERCHANT_SERIAL_NUMBER=
MOBILEPAY_WEBHOOK_SECRET=
MOBILEPAY_RETURN_URL=http://localhost:3000/en/donate/complete
MOBILEPAY_CALLBACK_URL=http://localhost:4000/webhooks/mobilepay

# ── Provider enable flags (admins can also flip in /admin → Settings) ──────
PAYMENTS_BANK_TRANSFER_ENABLED=true
PAYMENTS_PAYTRAIL_ENABLED=true
PAYMENTS_MOBILEPAY_ENABLED=false

# ── Bank-transfer reconciliation cron auth ─────────────────────────────────
# Shared HMAC secret protecting `POST /webhooks/bank-transfer`. Required
# in production; the accountant's reconciliation cron computes
#   hex(HMAC-SHA256(BANK_TRANSFER_WEBHOOK_SECRET, rawBody))
# and sends it as `Authorization: HMAC-SHA256 <hex>`. /admin manual
# uploads via /v1/reconciliation/entries are role-guarded and do NOT
# need this secret.
BANK_TRANSFER_WEBHOOK_SECRET=

# ── Local LLM (Ollama, self-hosted) ─────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b-instruct-q5_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
RERANKER_URL=http://localhost:8080
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Object storage (MinIO in dev; MinIO or B2 in prod) ──────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-north-1
S3_BUCKET=bloomoulu-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── Observability (LGTM + GlitchTip, self-hosted) ───────────────────────────
GLITCHTIP_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bloomoulu-api

# ── Alerts (ntfy.sh, self-hosted) ───────────────────────────────────────────
NTFY_URL=https://ntfy.sh
NTFY_TOPIC_P0=bloomoulu-p0
NTFY_TOPIC_P1=bloomoulu-p1
NTFY_TOPIC_P2=bloomoulu-p2

# ── Garden / Org config ─────────────────────────────────────────────────────
GARDEN_ORG_NAME="Oulun yliopiston kasvitieteellinen puutarha"
GARDEN_ORG_VAT_ID=FI02452579     # University of Oulu Y-tunnus (placeholder)
GARDEN_ADDRESS="Linnanmaa, 90014 Oulun yliopisto, Finland"
GARDEN_IBAN="FI00 0000 0000 0000 00"
GARDEN_BIC=OKOYFIHH
GARDEN_NONPROFIT_VAT_EXEMPT=true # yleishyödyllinen yhteisö — confirm with Vero
GARDEN_TAX_YEAR_CUTOFF=12-31

# Feature flags (also editable from /admin → settings)
FEATURE_KIOSK=true
FEATURE_RAG=true
FEATURE_PAY_BY_BANK=false
