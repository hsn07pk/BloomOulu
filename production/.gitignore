*.bak

# Test-payments overlay + dev process artifacts (created by
# scripts/payment-test-up.sh — see docs/TESTING.md). Both contain
# tunnel URLs and a generated webhook secret; never commit.
.env.test-payments
.run/

# Runtime local-disk storage — generated PDFs, plant images, narrations,
# GDPR exports etc. STORAGE_DIR resolves here in dev; never commit.
apps/api/var/

# Local database backups — pg_dump output (.dump), the restore notes
# (RESTORE.md) and the dump log. Large binaries + local-only docs that
# are recreated on demand; never commit.
db-dumps/
