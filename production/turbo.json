{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "MOBILEPAY_CLIENT_ID",
    "MOBILEPAY_CLIENT_SECRET",
    "MOBILEPAY_SUBSCRIPTION_KEY",
    "MOBILEPAY_MERCHANT_SERIAL_NUMBER",
    "MOBILEPAY_WEBHOOK_SECRET",
    "MISTRAL_API_KEY",
    "COHERE_API_KEY",
    "AUTH_SECRET",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WEB_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@bloomoulu/db#migrate:deploy": {
      "cache": false
    },
    "@bloomoulu/db#seed": {
      "cache": false
    }
  }
}
