{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "AUTH_SECRET",
    "ADMIN_BOOTSTRAP_EMAIL",
    "ADMIN_BOOTSTRAP_PASSWORD_HASH",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WEB_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_KIOSK_URL",
    "INTERNAL_API_URL",
    "PAYTRAIL_MERCHANT_ID",
    "PAYTRAIL_SECRET",
    "PAYTRAIL_WEBHOOK_SECRET",
    "PAYTRAIL_API_URL",
    "PAYTRAIL_MOCK",
    "PAYTRAIL_CALLBACK_URL",
    "PAYTRAIL_RETURN_URL",
    "MOBILEPAY_CLIENT_ID",
    "MOBILEPAY_CLIENT_SECRET",
    "MOBILEPAY_SUBSCRIPTION_KEY",
    "MOBILEPAY_MERCHANT_SERIAL_NUMBER",
    "MOBILEPAY_WEBHOOK_SECRET",
    "MOBILEPAY_API_URL",
    "MOBILEPAY_CALLBACK_URL",
    "MOBILEPAY_RETURN_URL",
    "PAYMENTS_BANK_TRANSFER_ENABLED",
    "PAYMENTS_PAYTRAIL_ENABLED",
    "PAYMENTS_MOBILEPAY_ENABLED",
    "BANK_TRANSFER_WEBHOOK_SECRET",
    "GARDEN_IBAN",
    "GARDEN_BIC",
    "GARDEN_ORG_NAME",
    "GARDEN_ORG_VAT_ID",
    "GARDEN_ADDRESS",
    "GARDEN_DONATE_URL",
    "MISTRAL_API_KEY",
    "COHERE_API_KEY",
    "OLLAMA_URL",
    "OLLAMA_BASE_URL",
    "OLLAMA_LLM_MODEL",
    "OLLAMA_EMBED_MODEL",
    "LLM_MODEL",
    "EMBED_MODEL",
    "RERANKER_URL",
    "RERANKER_MODEL",
    "ASK_CURATOR_EMAIL",
    "ASK_CURATOR_NAME",
    "ASK_CURATOR_REPLY_SLA_DAYS",
    "STORAGE_DIR",
    "BLOOMOULU_ENABLE_SWAGGER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@bloomoulu/db#migrate:deploy": {
      "cache": false
    },
    "@bloomoulu/db#seed": {
      "cache": false
    }
  }
}
