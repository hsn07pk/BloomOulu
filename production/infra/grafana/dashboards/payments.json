{
  "uid": "bloomoulu-payments",
  "title": "BloomOulu · Payments",
  "tags": ["bloomoulu", "payments"],
  "timezone": "Europe/Helsinki",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Webhook success rate · 1h",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(bloomoulu_webhook_processed_total{status=\"ok\"}[1h])) / sum(rate(bloomoulu_webhook_processed_total[1h]))", "legendFormat": "ok ratio" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.98 }, { "color": "green", "value": 0.995 } ] } } }
    },
    {
      "type": "stat",
      "title": "Webhook p95 latency · 1h",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by(le, provider) (rate(bloomoulu_webhook_duration_ms_bucket[1h])))", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "stat",
      "title": "Refund rate · 7d",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "increase(bloomoulu_payments_total{status=\"refunded\"}[7d]) / increase(bloomoulu_payments_total{status=\"succeeded\"}[7d])" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "stat",
      "title": "Dunning recovered · 7d",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "increase(bloomoulu_dunning_recovered_total[7d])" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Webhook events per minute, by provider × status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum by (provider, status) (rate(bloomoulu_webhook_processed_total[5m]))", "legendFormat": "{{provider}} {{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Webhook duration histogram (p50/p95/p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by(le) (rate(bloomoulu_webhook_duration_ms_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by(le) (rate(bloomoulu_webhook_duration_ms_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by(le) (rate(bloomoulu_webhook_duration_ms_bucket[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "table",
      "title": "Reconciliation exceptions (last 30d)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "expr": "topk(20, bloomoulu_reconciliation_exceptions_total)" }
      ]
    }
  ]
}
