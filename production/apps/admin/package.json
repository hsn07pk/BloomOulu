{
  "name": "@bloomoulu/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/styles','dist/styles',{recursive:true})\"",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adminjs/fastify": "4.1.3",
    "@adminjs/prisma": "^5.0.3",
    "@babel/plugin-syntax-import-assertions": "^7.27.1",
    "@bloomoulu/constants": "workspace:*",
    "@bloomoulu/db": "workspace:*",
    "@bloomoulu/emails": "workspace:*",
    "@bloomoulu/rag": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/session": "^10.9.0",
    "@prisma/client": "^5.22.0",
    "adminjs": "^7.8.13",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.30.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
