# API-specific overrides. Inherits from the root .env.
DATABASE_URL=postgresql://bloomoulu:bloomoulu@localhost:5432/bloomoulu?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000

# Paytrail (test credentials from https://docs.paytrail.com/)
PAYTRAIL_MERCHANT_ID=375917
PAYTRAIL_SECRET=SAIPPUAKAUPPIAS
PAYTRAIL_API_URL=https://services.paytrail.com
PAYTRAIL_WEBHOOK_SECRET=SAIPPUAKAUPPIAS

# MobilePay sandbox
MOBILEPAY_API_URL=https://apitest.vipps.no
MOBILEPAY_CLIENT_ID=
MOBILEPAY_CLIENT_SECRET=
MOBILEPAY_SUBSCRIPTION_KEY=
MOBILEPAY_MERCHANT_SERIAL_NUMBER=
MOBILEPAY_WEBHOOK_SECRET=
MOBILEPAY_RETURN_URL=http://localhost:3000/fi/donate/complete

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b-instruct-q5_K_M
EMBED_MODEL=nomic-embed-text:v1.5
RERANKER_BASE_URL=http://localhost:8080

# Local-disk file storage (receipts, narrations, plant images, GDPR exports).
# Files are served by the api at /v1/files/<key>.
STORAGE_DIR=./var/storage

# Real SMTP — required to send mail. Gmail App Password example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=<you>@gmail.com  SMTP_PASS=<16-char-app-password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ntfy (dev: no-op)
NTFY_BASE_URL=
NTFY_TOPIC=bloomoulu-alerts

# Auth
AUTH_SECRET=dev-please-rotate
